# Falls das Document Root versehentlich auf den Projektstamm zeigt:
# Anfragen nach public/ leiten, Configs nicht ausliefern.

<FilesMatch "^config(\.secret)?(\.example)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
